oab15Cards OBJECT IDENTIFIER ::= { frm220 600 }
         
	oab15Table OBJECT-TYPE
		SYNTAX      SEQUENCE OF OAB15Entry
		MAX-ACCESS  not-accessible
		STATUS      current
		DESCRIPTION
				"A list of local OAB15 card entries.
				The number of entries is oab15-No-L."
		::= { oab15Cards 20 }

	oab15Entry OBJECT-TYPE
		SYNTAX      OAB15Entry
		MAX-ACCESS  not-accessible
		STATUS      current
		DESCRIPTION
				"An entry containing management information applicable
				to a particular local FRM220 OAB15 card."
		INDEX   { oab15ChassisIndex, oab15SlotIndex }
		::= {  oab15Table 1 }

	OAB15Entry ::=
		SEQUENCE {  
					oab15ChassisIndex    INTEGER,
					oab15SlotIndex		  INTEGER,
					oab15CardHWVer		  DisplayString,
					oab15CardFWVer		  DisplayString,
					oab15CardCPLDVer	  DisplayString,
					oab15CardFPGAVer	  DisplayString,  
					oab15PumpCurrentStatus DisplayString,
					oab15OutputPowerStatus DisplayString,
					oab15PumpPowerStatus DisplayString, 
					oab15TemperatureStatus DisplayString, 
					oab15OutputPower DisplayString,
					oab15DeviceActive    INTEGER,
					oab15DeviceReset     INTEGER,
					oab15SetDefault      INTEGER, 
					oab15LosAssert110GSXXSlot INTEGER, 
					oab15LosAssert110GSXXPropagation INTEGER,
					oab15LosAssert210GSXXSlot INTEGER, 
					oab15LosAssert210GSXXPropagation INTEGER, 
					oab15LosAssert310GSXXSlot INTEGER, 
					oab15LosAssert310GSXXPropagation INTEGER,
					oab15LosAssert410GSXXSlot INTEGER, 
					oab15LosAssert410GSXXPropagation INTEGER,
					oab15Alarm BITS,
					oab15Mgmt		INTEGER
				}
				
